    "business-readiness-360-v3-execution"
  ],
  "risks": [
    "Audit conclusions distinguish implementation, verification, and real-world evidence.",
    "Built-in detectors are read-only and conservative; absence of evidence never becomes PASS.",
    "No corpus repository code is authorized for execution or copying by inclusion in this pack.",
    "External adapters are opt-in; network-required adapters are not executed by local-safe mode.",
    "Not-applicable controls are excluded from scoring and retain an applicability reason.",
    "Legal/compliance findings may require qualified review."
  ],
  "test_commands": [
    "python3 -m unittest discover -s tests -v",
    "python3 runtime/br360_engine.py selftest"
  ]
