{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BUSINESS_READINESS_360_FINDING.schema.json",
  "title": "BR360 Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "audit_domain",
    "control_id",
    "title",
    "description",
    "severity",
    "confidence",
    "applicability",
    "evidence_level",
    "evidence",
    "affected_asset",
    "business_impact",
    "technical_impact",
    "operational_impact",
    "remediation",
    "estimated_effort",
    "automation_level",
    "source_method",
    "standard_refs",
    "fingerprint",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "audit_domain": {
      "type": "string"
    },
    "control_id": {
      "type": "string",
      "pattern": "^BR360-[A-Z0-9]+-[0-9]{3}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "applicability": {
      "enum": [
        "REQUIRED",
        "RECOMMENDED",
        "OPTIONAL",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "evidence_level": {
      "enum": [
        "E0_CLAIM_ONLY",
        "E1_STATIC",
        "E2_TESTED",
        "E3_RUNTIME",
        "E4_REAL_WORLD"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "BUSINESS_READINESS_360_EVIDENCE.schema.json"
      }
    },
    "affected_asset": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "business_impact": {
      "type": "string"
    },
    "technical_impact": {
      "type": "string"
    },
    "operational_impact": {
      "type": "string"
    },
    "remediation": {
      "type": "string"
    },
    "estimated_effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "automation_level": {
      "enum": [
        "AUTOMATED",
        "SEMI_AUTOMATED",
        "MANUAL",
        "REAL_WORLD_REQUIRED",
        "EXTERNAL_RESEARCH",
        "LEGAL_REVIEW"
      ]
    },
    "source_method": {
      "type": "string"
    },
    "standard_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fingerprint": {
      "type": "string"
    },
    "first_seen": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_seen": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "OPEN",
        "ACKNOWLEDGED",
        "RESOLVED",
        "SUPPRESSED",
        "FALSE_POSITIVE",
        "NOT_APPLICABLE"
      ]
    }
  }
}
